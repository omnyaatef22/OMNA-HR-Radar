Received","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1104,48],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"return [{ json: $('Validate Application').first().json, binary: $('Validate Application').first().binary }];"},"id":"n272","name":"Restore CV File","type":"n8n-nodes-base.code","typeVersion":2,"position":[1104,-208]},{"parameters":{"operation":"pdf","options":{}},"id":"n273","name":"Extract CV Text","type":"n8n-nodes-base.extractFromFile","typeVersion":1.1,"position":[1328,-208],"onError":"continueErrorOutput"},{"parameters":{"documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":501,"mode":"id","cachedResultName":"Jobs"},"filtersUI":{"values":[{"lookupColumn":"job_id","lookupValue":"={{ $('Validate Application').item.json.job_id }}"}]},"options":{}},"id":"n274","name":"Read Job","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1552,-208],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// Remove personal identifiers before the model sees the CV, so the score depends on skills, not on who the person is.\nconst a = $('Validate Application').first().json; const job = $input.first().json;\nlet cv = String($('Extract CV Text').first().json.text || '');\nif (cv.replace(/\\s/g, '').length < 300) throw new Error('VALIDATION: CV for ' + a.email + ' has almost no text (scanned image?)');\ncv = cv.replace(/[^\\s@]+@[^\\s@]+/g, '[email]').replace(/(\\+?\\d[\\d\\s-]{8,}\\d)/g, '[phone]').split(a.name).join('[candidate]')\n  .replace(/\\b(male|female|married|single|religion|date of birth|birth date|age|ذكر|أنثى|متزوج|أعزب|الديانة|تاريخ الميلاد)\\b[^\\n]*/gi, '[removed]').slice(0, 12000);\nreturn [{ json: { job, prompt: 'You screen CVs fairly. Ignore name, gender, age, religion, nationality, photos and marital status. Job: ' + job.title +\n  '. Must have: ' + job.must_have + '. Nice to have: ' + job.nice_to_have + '. Minimum years: ' + job.min_years +\n  '. Return JSON only: {\"score\": 0-100 integer, \"years_experience\": number, \"skills\": [\"...\"], \"must_have_met\": [\"...\"], \"must_have_missing\": [\"...\"], \"reasons\": [\"3 short evidence-based reasons quoting the CV\"]}. CV:\\n<<<' + cv + '>>>' } }];"},"id":"n275","name":"Prepare Fair Scoring","type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,-208]},{"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}","options":{"timeout":60000}},"id":"n276","name":"AI Score CV","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1984,-208],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// Clamp and sanity-check the model output, then apply HR's rules (not the model's) to decide.\nconst a = $('Validate Application').first().json; const job = $('Prepare Fair Scoring').first().json.job;\nlet s; try { s = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { throw new Error('AI_OUTPUT: CV score was not valid JSON for ' + a.email); }\nlet score = Math.round(Number(s.score)); if (!(score >= 0 && score <= 100)) throw new Error('AI_OUTPUT: score out of range: ' + s.score);\nconst reasons = (s.reasons || []).filter(r => String(r).length > 10);\nif (reasons.length < 2) throw new Error('AI_OUTPUT: score for ' + a.email + ' came without evidence');\nconst missing = s.must_have_missing || [];\nif (missing.length) score = Math.min(score, 60); // a missing must-have can never lead to an interview\nif (a.years < Number(job.min_years)) score = Math.min(score, 55);\nconst decision = score >= 75 ? 'interview' : score >= 50 ? 'hold' : 'reject';\nconst id = 'A-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\nreturn [{ json: { ...a, applicant_id: id, score, decision, skills: (s.skills || []).slice(0, 12).join(', '), reasons: reasons.join(' | ') + (missing.length ? ' | missing: ' + missing.join(', ') : ''), interviewer: job.interviewer_email, job_title: job.title } }];"},"id":"n277","name":"Validate Score","type":"n8n-nodes-base.code","typeVersion":2,"position":[2208,-208]},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":502,"mode":"id","cachedResultName":"Applicants"},"columns":{"mappingMode":"defineBelow","value":{"applicant_id":"={{ $json.applicant_id }}","received_at":"={{ $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm') }}","job_id":"={{ $json.job_id }}","name":"={{ $json.name }}","email":"={{ $json.email }}","phone":"={{ $json.phone }}","years":"={{ $json.years }}","skills":"={{ $json.skills }}","score":"={{ $json.score }}","reasons":"={{ $json.reasons }}","decision":"={{ $json.decision }}","status":"screened"},"matchingColumns":[],"schema":[{"id":"applicant_id","displayName":"applicant_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"received_at","displayName":"received_at","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"job_id","displayName":"job_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"name","displayName":"name","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"email","displayName":"email","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch"