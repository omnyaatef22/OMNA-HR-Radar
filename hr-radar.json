tName":"Applicants"},"options":{}},"id":"n259","name":"Read Applicants","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[220,300],"alwaysOutputData":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// Today's applicants ranked by score, grouped by job, with the model's reasons so HR can disagree quickly.\nconst today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(a => a.applicant_id && String(a.received_at).startsWith(today)).sort((a, b) => b.score - a.score);\nif (!rows.length) return [];\nconst byJob = {}; rows.forEach(a => (byJob[a.job_id] = byJob[a.job_id] || []).push(a));\nconst html = Object.entries(byJob).map(([j, list]) => '<h3>' + j + ' (' + list.length + ')</h3><table border=\"1\" cellpadding=\"5\"><tr><th>Score</th><th>Name</th><th>Years</th><th>Decision</th><th>Reasons</th></tr>' +\n  list.map(a => '<tr><td>' + a.score + '</td><td>' + a.name + '</td><td>' + a.years + '</td><td>' + a.decision + '</td><td>' + a.reasons + '</td></tr>').join('') + '</table>').join('');\nconst text = '👥 ' + rows.length + ' applicant(s) today · ' + rows.filter(a => a.decision === 'interview').length + ' invited to interview · top: ' + rows[0].name + ' (' + rows[0].score + ')';\nreturn [{ json: { html, text, count: rows.length } }];"},"id":"n260","name":"Build Shortlist","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,300]},{"parameters":{"sendTo":"YOUR_SEND_TO","subject":"={{ 'HR Radar shortlist · ' + $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd') }}","emailType":"html","message":"={{ $json.html }}","options":{"appendAttribution":false}},"id":"n261","name":"Email Shortlist","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[660,240],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"chatId":"YOUR_CHAT_ID","text":"={{ $json.text }}","additionalFields":{"appendAttribution":false}},"id":"n262","name":"Post Summary","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[660,380],"onError":"continueRegularOutput"}],"connections":{"Error Trigger":{"main":[[{"node":"Classify Error","type":"main","index":0}]]},"Classify Error":{"main":[[{"node":"Log Error","type":"main","index":0}]]},"Log Error":{"main":[[{"node":"Alert Team","type":"main","index":0}]]},"Alert Team":{"main":[[{"node":"Critical?","type":"main","index":0}]]},"Critical?":{"main":[[{"node":"Email Critical Error","type":"main","index":0}]]},"Workdays 17:00":{"main":[[{"node":"Read Applicants","type":"main","index":0}]]},"Read Applicants":{"main":[[{"node":"Build Shortlist","type":"main","index":0}]]},"Build Shortlist":{"main":[[{"node":"Email Shortlist","type":"main","index":0},{"node":"Post Summary","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","timezone":"Africa/Cairo"}},"HR Radar 1 · Applications & Screening":{"name":"HR Radar 1 · Applications & Screening","nodes":[{"parameters":{"formTitle":"Apply now","formDescription":"Upload your CV as a PDF. We reply to every applicant within 3 working days.","formFields":{"values":[{"fieldLabel":"Full name","fieldName":"name","requiredField":true},{"fieldLabel":"Email","fieldType":"email","fieldName":"email","requiredField":true},{"fieldLabel":"Mobile","fieldName":"phone","requiredField":true},{"fieldLabel":"Position","fieldType":"dropdown","fieldName":"job","fieldOptions":{"values":[{"option":"J-01 · Junior Automation Engineer"},{"option":"J-02 · Data Analyst"}]},"requiredField":true},{"fieldLabel":"Years of experience","fieldType":"number","fieldName":"years","requiredField":true},{"fieldLabel":"CV (PDF, max 5 MB)","fieldType":"file","fieldName":"cv","multipleFiles":false,"acceptFileTypes":".pdf","requiredField":true},{"fieldLabel":"I agree that my data is used for this application only","fieldType":"checkbox","fieldName":"consent","fieldOptions":{"values":[{"option":"I agree"}]},"requiredField":true}]},"options":{"respondWithOptions":{"values":{"formSubmittedText":"Thank you! Your application was received. You will get an email from us soon."}}}},"id":"n263","name":"Application Form","type":"n8n-nodes-base.formTrigger","typeVersion":2.5,"position":[0,0]},{"parameters":{"jsCode":"// Check every field and the file itself. The CV binary is renamed to \"data\" for the next nodes.\nconst j = $json; const bins = $input.first().binary || {};\nconst g = (k, l) => String(j[k] ?? j[l] ?? '').trim();\nconst file = Object.values(bins)[0];\nconst a = { name: g('name', 'Full name'), email: g('email', 'Email').toLowerCase(), phone: g('phone', 'Mobile').replace(/[^0-9+]/g, '').replace(/^(\\+20|0020|20)(?=1)/, '0'),\n  job_id: (g('job', 'Position').match(/J-\\d{2}/) || [''])[0], years: Number(g('years', 'Years of experience')) };\nconst p = [];\nif (a.name.split(/\\s+/).length < 2) p.push('please write your full name');\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(a.email)) p.push('email address looks invalid');\nif (!/^01[0125]\\d{8}$/.test(a.phone)) p.push('mobile must be an Egyptian number like 01012345678');\nif (!a.job_id) p.push('position missing');\nif (!(a.years >= 0 && a.years <= 50)) p.push('years of experience must be between 0 and 50');\nif (!file) p.push('CV file missing');\nelse { if (!/pdf/.test(file.mimeType || '')) p.push('CV must be a PDF'); if (Number(file.fileSize?.toString().replace(/[^0-9.]/g, '')) > 5 * 1024 && /MB/.test(file.fileSize || '')) p.push('CV is larger than 5 MB'); }\nreturn [{ json: { ...a, problems: p, ok: !p.length }, binary: file ? { data: file } : {} }];"},"id":"n264","name":"Validate Application","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c265","leftValue":"={{ $json.ok }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"n266","name":