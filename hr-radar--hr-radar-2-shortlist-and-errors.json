    {
      "parameters": {
        "jsCode": "// Today's applicants ranked by score, grouped by job, with the model's reasons so HR can disagree quickly.\nconst today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(a => a.applicant_id && String(a.received_at).startsWith(today)).sort((a, b) => b.score - a.score);\nif (!rows.length) return [];\nconst byJob = {}; rows.forEach(a => (byJob[a.job_id] = byJob[a.job_id] || []).push(a));\nconst html = Object.entries(byJob).map(([j, list]) => '<h3>' + j + ' (' + list.length + ')</h3><table border=\"1\" cellpadding=\"5\"><tr><th>Score</th><th>Name</th><th>Years</th><th>Decision</th><th>Reasons</th></tr>' +\n  list.map(a => '<tr><td>' + a.score + '</td><td>' + a.name + '</td><td>' + a.years + '</td><td>' + a.decision + '</td><td>' + a.reasons + '</td></tr>').join('') + '</table>').join('');\nconst text = '👥 ' + rows.length + ' applicant(s) today · ' + rows.filter(a => a.decision === 'interview').length + ' invited to interview · top: ' + rows[0].name + ' (' + rows[0].score + ')';\nreturn [{ json: { html, text, count: rows.length } }];"
      },
