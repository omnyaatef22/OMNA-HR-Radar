    {
      "parameters": {
        "jsCode": "// Check every field and the file itself. The CV binary is renamed to \"data\" for the next nodes.\nconst j = $json; const bins = $input.first().binary || {};\nconst g = (k, l) => String(j[k] ?? j[l] ?? '').trim();\nconst file = Object.values(bins)[0];\nconst a = { name: g('name', 'Full name'), email: g('email', 'Email').toLowerCase(), phone: g('phone', 'Mobile').replace(/[^0-9+]/g, '').replace(/^(\\+20|0020|20)(?=1)/, '0'),\n  job_id: (g('job', 'Position').match(/J-\\d{2}/) || [''])[0], years: Number(g('years', 'Years of experience')) };\nconst p = [];\nif (a.name.split(/\\s+/).length < 2) p.push('please write your full name');\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(a.email)) p.push('email address looks invalid');\nif (!/^01[0125]\\d{8}$/.test(a.phone)) p.push('mobile must be an Egyptian number like 01012345678');\nif (!a.job_id) p.push('position missing');\nif (!(a.years >= 0 && a.years <= 50)) p.push('years of experience must be between 0 and 50');\nif (!file) p.push('CV file missing');\nelse { if (!/pdf/.test(file.mimeType || '')) p.push('CV must be a PDF'); if (Number(file.fileSize?.toString().replace(/[^0-9.]/g, '')) > 5 * 1024 && /MB/.test(file.fileSize || '')) p.push('CV is larger than 5 MB'); }\nreturn [{ json: { ...a, problems: p, ok: !p.length }, binary: file ? { data: file } : {} }];"
      },
