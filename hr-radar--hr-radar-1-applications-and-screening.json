    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n276",
      "name": "AI Score CV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1984,
        -208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Clamp and sanity-check the model output, then apply HR's rules (not the model's) to decide.\nconst a = $('Validate Application').first().json; const job = $('Prepare Fair Scoring').first().json.job;\nlet s; try { s = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { throw new Error('AI_OUTPUT: CV score was not valid JSON for ' + a.email); }\nlet score = Math.round(Number(s.score)); if (!(score >= 0 && score <= 100)) throw new Error('AI_OUTPUT: score out of range: ' + s.score);\nconst reasons = (s.reasons || []).filter(r => String(r).length > 10);\nif (reasons.length < 2) throw new Error('AI_OUTPUT: score for ' + a.email + ' came without evidence');\nconst missing = s.must_have_missing || [];\nif (missing.length) score = Math.min(score, 60); // a missing must-have can never lead to an interview\nif (a.years < Number(job.min_years)) score = Math.min(score, 55);\nconst decision = score >= 75 ? 'interview' : score >= 50 ? 'hold' : 'reject';\nconst id = 'A-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\nreturn [{ json: { ...a, applicant_id: id, score, decision, skills: (s.skills || []).slice(0, 12).join(', '), reasons: reasons.join(' | ') + (missing.length ? ' | missing: ' + missing.join(', ') : ''), interviewer: job.interviewer_email, job_title: job.title } }];"
      },
