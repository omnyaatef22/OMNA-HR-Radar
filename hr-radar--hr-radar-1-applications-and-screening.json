    {
      "parameters": {
        "jsCode": "// Next 3 working days (Sun–Thu) at 11:00, 13:00, 15:00 Cairo time. Calendar decides which is free.\nconst out = []; let d = $now.setZone('Africa/Cairo').plus({ days: 1 }).startOf('day');\nwhile (out.length < 9) { if (![5, 6].includes(d.weekday)) for (const h of [11, 13, 15]) out.push({ json: { start: d.set({ hour: h }).toISO(), end: d.set({ hour: h, minute: 45 }).toISO() } }); d = d.plus({ days: 1 }); }\nreturn out;"
      },
