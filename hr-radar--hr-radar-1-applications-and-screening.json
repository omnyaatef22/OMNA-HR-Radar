        "jsCode": "const slots = $('Propose Slots').all().map(i => i.json); const free = $input.all().map((i, k) => ({ ...slots[k], available: i.json.available }));\nconst slot = free.find(s => s.available);\nif (!slot) throw new Error('VALIDATION: no free interview slot in the next 3 working days for ' + $('Validate Score').first().json.email);\nreturn [{ json: { ...$('Validate Score').first().json, ...slot } }];"
