    {
      "parameters": {
        "jsCode": "// Remove personal identifiers before the model sees the CV, so the score depends on skills, not on who the person is.\nconst a = $('Validate Application').first().json; const job = $input.first().json;\nlet cv = String($('Extract CV Text').first().json.text || '');\nif (cv.replace(/\\s/g, '').length < 300) throw new Error('VALIDATION: CV for ' + a.email + ' has almost no text (scanned image?)');\ncv = cv.replace(/[^\\s@]+@[^\\s@]+/g, '[email]').replace(/(\\+?\\d[\\d\\s-]{8,}\\d)/g, '[phone]').split(a.name).join('[candidate]')\n  .replace(/\\b(male|female|married|single|religion|date of birth|birth date|age|ذكر|أنثى|متزوج|أعزب|الديانة|تاريخ الميلاد)\\b[^\\n]*/gi, '[removed]').slice(0, 12000);\nreturn [{ json: { job, prompt: 'You screen CVs fairly. Ignore name, gender, age, religion, nationality, photos and marital status. Job: ' + job.title +\n  '. Must have: ' + job.must_have + '. Nice to have: ' + job.nice_to_have + '. Minimum years: ' + job.min_years +\n  '. Return JSON only: {\"score\": 0-100 integer, \"years_experience\": number, \"skills\": [\"...\"], \"must_have_met\": [\"...\"], \"must_have_missing\": [\"...\"], \"reasons\": [\"3 short evidence-based reasons quoting the CV\"]}. CV:\\n<<<' + cv + '>>>' } }];"
      },
      "id": "n275",
      "name": "Prepare Fair Scoring",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
